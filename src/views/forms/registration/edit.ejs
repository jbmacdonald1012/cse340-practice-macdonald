<%- include('../../partials/header') %>

<main>
    <h1><%= title %></h1>

    <form method="POST" action="/register/<%= user.id %>/edit" class="edit-form">
        <div class="form-group">
            <label for="name">Name</label>
            <input type="text" id="name" name="name" value="<%= user.name %>" placeholder="Enter your name" required>
        </div>

        <div class="form-group">
            <label for="email">Email Address</label>
            <input type="email" id="email" name="email" value="<%= user.email %>" placeholder="Enter your email address" required>
        </div>

        <button type="submit">Update Account</button>

        <div class="form-footer">
            <a href="/register/list">Cancel</a>
        </div>
    </form>
</main>

<%- include('../../partials/footer') %>
